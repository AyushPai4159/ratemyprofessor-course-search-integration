{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "Registron",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@example.com",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "src/popup_menu/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "host_permissions": [
    "https://www.ratemyprofessors.com/"
  ],
  "permissions": [
    "webRequest",
    "webNavigation",
    "tabs",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/bg_page.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "http://pa.cc.unc.edu/*",
        "https://pa.cc.unc.edu/*"
      ],
      "js": ["src/content_scripts/controller.ts"],
      "css": ["src/styles.css"]
    }
  ]
}